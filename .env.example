# PORT: Development and runtime port
PORT=3000

# GEMINI_API_KEY: Injected by AI Studio runtime for Gemini AI model calls
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: Optional API key for Groq high-speed inference
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

# HINDSIGHT_API: Vectorize Hindsight Persistent Agent Memory API
HINDSIGHT_BASE_URL="https://api.hindsight.vectorize.io"
HINDSIGHT_API_KEY=""
HINDSIGHT_BANK_ID="content-strategy"

# DATABASE_URL: Local SQLite file location
DATABASE_URL="./data/content_intelligence.db"

# DEMO_MODE: Enable seeded sample content and demonstration features
DEMO_MODE="true"

# APP_URL: Service URL
APP_URL="MY_APP_URL"
FRONTEND_URL="http://localhost:3000"

